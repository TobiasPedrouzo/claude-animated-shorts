  "sources": [
    {
      "id": "nasa",
      "url": "https://nssdc.gsfc.nasa.gov/planetary/lunar/apollo_15_feather_drop.html",
      "evidence": "David Scott demonstrated a hammer and feather falling together on Apollo 15 in near vacuum, without air resistance."
    },
    {
      "id": "harvard",
      "url": "https://sciencedemonstrations.fas.harvard.edu/presentations/feather-and-dime",
      "evidence": "A feather and coin fall at different rates with air in the tube; evacuating the tube lets them fall together."
    }
  ],
  "facts": [
    {
      "id": "drop",
      "claim": "David Scott dropped a hammer and feather on the Moon during Apollo 15 in 1971; they reached the surface together.",
      "source": "nasa"
    },
    {
      "id": "air",
      "claim": "Air resistance changes the observed fall of a feather relative to a dense object.",
      "source": "harvard"
    },
    {
      "id": "vacuum",
      "claim": "Objects released together from the same height with negligible air resistance share the same gravitational acceleration, regardless of mass.",
      "source": "nasa"
    }
  ],
